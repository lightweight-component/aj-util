{% set isChinese = false %}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
        <title>{{ project }} - {{ title }}</title>
        <meta name="description" content="Small Java utilities with many useful functions. {{description}}" />
        <meta name="keywords" content="AJ Utils, ajaxjs, ajaxjs framework, java utilities, tools, helper, {{tags}}" />
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="stylesheet" href="https://framework.ajaxjs.com/static/new-ui/css/common.css" />
        <link rel="stylesheet" href="https://iam.ajaxjs.com/asset/main.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.12.0/styles/github.min.css" />
        <link rel="stylesheet" href="/asset/css/docs-theme.css" />
        <link rel="icon" type="image/x-icon" href="https://framework.ajaxjs.com/aj-logo/logo.ico"/>
        <script defer src="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.12.0/highlight.min.js"></script>
        <script src="/asset/js/common.js"></script>
        <script>
            AJUtils.initTheme();
            AJUtils.onReady(function () { AJUtils.bindThemeToggle(); AJUtils.bindDocumentationLanguageToggle(); });

            var _hmt = _hmt || [];
            (function() {
              var hm = document.createElement("script");
              hm.src = "https://hm.baidu.com/hm.js?208c5aea11c52991bd1c3283e62ad0ce";
              var s = document.getElementsByTagName("script")[0];
              s.parentNode.insertBefore(hm, s);
            })();
        </script>
    </head>
    <body>
        <nav>
            <div>
                <div class="links">
                    <a href="/">🏠 Home</a>
                    | ⚙️ Source:
                    <a target="_blank" href="https://github.com/lightweight-component/aj-util">Github</a>/<a target="_blank" href="https://gitcode.com/lightweight-component/aj-util">Gitcode</a>
                    | <button class="language-toggle" type="button" data-document-language-toggle data-language-target="{% if alternate %}/{{ project }}{{ alternate }}{% else %}/{{ project }}/cn/{% endif %}" aria-label="Switch language to Chinese" title="切换至中文">中</button>
                    | <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" title="Switch theme">☾</button>
                </div>
                <h1>
                    <img src="https://framework.ajaxjs.com/aj-logo/logo.png" style="vertical-align: middle;height: 45px;margin-bottom: 6px;" />
                    {{ project }}
                </h1>
                <h3>Java Tools Documentation</h3>
            </div>
        </nav>
        <div class="docs-layout">
            <menu class="docs-navigation" aria-label="Documentation navigation">
                {% include "project-select.njk" %}
                <ul>
                    <li class="selected">
                        <a href="/{{ project }}/">Home</a>
                    </li>
                </ul>
                {% if project == "aj-util" %}
                <h3>Common</h3>
                <ul>
                    <li><a href="/aj-util/common/JsonUtil/">JsonUtil</a></li>
                    <li><a href="/aj-util/common/Base64Utils/">Base64Utils</a></li>
                    <li><a href="/aj-util/common/StringBytes/">StringBytes</a></li>
                    <li><a href="/aj-util/common/ConvertBasicValue/">ConvertBasicValue</a></li>
                    <li><a href="/aj-util/common/HashHelper/">HashHelper</a></li>
                    <li><a href="/aj-util/common/MapTool/">MapTool</a></li>
                    <li><a href="/aj-util/common/ObjectHelper/">ObjectHelper</a></li>
                    <li><a href="/aj-util/common/RandomTools/">RandomTools</a></li>
                    <li><a href="/aj-util/common/RegExpHelper/">RegExpHelper</a></li>
                    <li><a href="/aj-util/common/StrUtil/">StrUtil</a></li>
                    <li><a href="/aj-util/common/UrlCodec/">UrlCodec</a></li>
                    <li><a href="/aj-util/common/XmlHelper/">XmlHelper</a></li>
                </ul>
                <h3>Date Handing</h3>
                <ul>
                    <li><a href="/aj-util/date/intro/">Introduction</a></li>
                    <li><a href="/aj-util/date/convert/">Date Converter</a></li>
                    <li><a href="/aj-util/date/formatter/">Date Formatter</a></li>
                </ul>
                <h3>Reflection</h3>
                <ul>
                    <li><a href="/aj-util/reflect/Methods/">Methods</a></li>
                    <li><a href="/aj-util/reflect/Types/">Types</a></li>
                    <li><a href="/aj-util/reflect/Clazz/">Clazz</a></li>
                    <li><a href="/aj-util/reflect/NewInstance/">NewInstance</a></li>
                    <li><a href="/aj-util/reflect/Fields/">Fields</a></li>
                </ul>

                <h3>IO</h3>
                <ul>
                    <li><a href="/aj-util/io/FileHelper/">FileHelper</a></li>
                    <li><a href="/aj-util/io/ResourceHelper/">ResourceHelper</a></li>
                    <li><a href="/aj-util/io/DataIO/">DataReader/DataWriter</a></li>
                    <li><a href="/aj-util/io/ZipHelper/">ZipHelper</a></li>
                    <li><a href="/aj-util/io/UnzipHelper/">UnzipHelper</a></li>
                </ul>

               <h3>Cryptography</h3>
               <ul>
                <li><a href="/aj-util/cryptography/intro/">Introduction</a></li>
                <li><a href="/aj-util/cryptography/flow/">Basic Flow</a></li>
                <li><a href="/aj-util/cryptography/Cryptography/">Symmetric encryption</a></li>
                <li><a href="/aj-util/cryptography/Rsa/">RSA</a></li>
               </ul>
               <h3>Misc.</h3>
               <ul>
               <li><a href="/aj-util/misc/jackson3/">Working with Jackson3</a></li>
                <li><a href="/aj-util/misc/Logging/">Logging utilities</a></li>
                <li><a href="/aj-util/misc/contact/">Contact</a></li>
               </ul>
                {% endif %}
                {% if project == "aj-http" %}
                <h3>HTTP Request</h3>
                <ul>
                    <li><a href="/aj-http/http_request/Base/">Lifecycle and Responses</a></li>
                    <li><a href="/aj-http/http_request/Get/">HTTP Method Helpers</a></li>
                    <li><a href="/aj-http/http_request/Transfer/">Uploads and Downloads</a></li>
                    <li><a href="/aj-http/http_request/ProxySecurity/">Proxy, Streams and TLS</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-qrcode" %}
                <h3>QR Code</h3>
                <ul>
                    <li><a href="/aj-qrcode/getting-started/">Getting started</a></li>
                    <li><a href="/aj-qrcode/rendering/">PNG and SVG rendering</a></li>
                    <li><a href="/aj-qrcode/segments/">Text, bytes, and segments</a></li>
                    <li><a href="/aj-qrcode/advanced/">Advanced encoding and limits</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-s3client" %}
                <h3>S3 client</h3>
                <ul>
                    <li><a href="/aj-s3client/signature-v4/">Signature Version 4</a></li>
                    <li><a href="/aj-s3client/signature-v2/">Signature Version 2</a></li>
                    <li><a href="/aj-s3client/factories/">Provider factories</a></li>
                    <li><a href="/aj-s3client/api/">API and limitations</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-ftp" %}
                <h3>File transfer</h3>
                <ul>
                    <li><a href="/aj-ftp/upload/">Upload files</a></li>
                    <li><a href="/aj-ftp/download/">Download files</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-json" %}
                <h3>Learning JSON parsing</h3>
                <ul><li><a href="/aj-json/parse/">Parse your first JSON</a></li><li><a href="/aj-json/how-it-works/">How the parser works</a></li></ul>
                {% endif %}
            </menu>
            <article class="aj-text">
                {{ content | safe }}
            </article>
        </div>

       <footer>
            {{ project }}, a part of <a href="https://framework.ajaxjs.com" target="_blank">AJ-Framework</a> open source. Mail:
            frank@ajaxjs.com, visit <a href="https://blog.csdn.net/zhangxin09" target="_blank">my blog(In Chinese)</a>.
            <br />
            <br />
            Copyright © 2025 Frank Cheung. All rights reserved.
        </footer>
    </body>
</html>
