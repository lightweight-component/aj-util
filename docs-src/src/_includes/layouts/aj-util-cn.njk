{% set isChinese = true %}
<!DOCTYPE html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
        <title>{{ project }} - {{ title }}</title>
        <meta name="description" content="Small Java utilities with many useful functions. {{description}}" />
        <meta name="keywords" content="AJ Utils, ajaxjs, ajaxjs framework, java utilities, tools, helper, {{tags}}" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@200..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap&family=Noto+Sans+SC:wght@100..900&display=swap" />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap" /> 
        <link rel="stylesheet" href="https://framework.ajaxjs.com/static/new-ui/css/common.css" />
        <link rel="stylesheet" href="https://iam.ajaxjs.com/asset/main.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.12.0/styles/github.min.css" />
        <link rel="stylesheet" href="/asset/css/docs-theme.css" />
        <link rel="icon" type="image/x-icon" href="https://framework.ajaxjs.com/aj-logo/logo.ico" />
        <script defer src="https://cdn.jsdelivr.net/npm/@highlightjs/cdn-assets@11.12.0/highlight.min.js"></script>
        <script src="/asset/js/common.js"></script>
        <script>
            AJUtils.initTheme();
            AJUtils.onReady(function () { AJUtils.bindThemeToggle(); AJUtils.bindDocumentationLanguageToggle(); });

            var _hmt = _hmt || [];
            (function() {
              var hm = document.createElement("script");
              hm.src = "https://hm.baidu.com/hm.js?208c5aea11c52991bd1c3283e62ad0ce";
              var s = document.getElementsByTagName("script")[0];
              s.parentNode.insertBefore(hm, s);
            })();
        </script>
    </head>
    <body>
        <nav>
            <div>
                <div class="links">
                    <a href="/">🏠 首页</a>
                    | ⚙️ 源码:
                    <a target="_blank" href="https://github.com/lightweight-component/aj-util">Github</a>/<a target="_blank" href="https://gitcode.com/lightweight-component/aj-util">Gitcode</a>
                  
                   | <button class="language-toggle" type="button" data-document-language-toggle data-language-target="{% if alternate %}/{{ project }}{{ alternate }}{% else %}/{{ project }}/{% endif %}" aria-label="Switch language to English" title="Switch to English">EN</button>
                   | <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换深色模式" title="切换深色模式">☾</button>
                </div>
                <h1>
                    <img src="https://framework.ajaxjs.com/aj-logo/logo.png" style="vertical-align: middle;height: 45px;margin-bottom: 6px;" />
                    {{ project }}
                </h1>
                <h3>Java 工具项目文档
                </h3>
            </div>
        </nav>
        <div class="docs-layout">
            <menu class="docs-navigation" aria-label="文档导航">
                {% include "project-select.njk" %}
                <ul>
                    <li class="selected">
                        <a href="/{{ project }}/cn/">首页</a>
                    </li>
                </ul>
                {% if project == "aj-util" %}
                <h3>Common 常用模块</h3>
                <ul>
                    <li><a href="/aj-util/common/JsonUtil-cn/">JsonUtil</a></li>
                    <li><a href="/aj-util/common/Base64Utils-cn/">Base64Utils</a></li>
                    <li><a href="/aj-util/common/StringBytes-cn/">StringBytes</a></li>
                    <li><a href="/aj-util/common/ConvertBasicValue-cn/">ConvertBasicValue</a></li>
                    <li><a href="/aj-util/common/HashHelper-cn/">HashHelper</a></li>
                    <li><a href="/aj-util/common/MapTool-cn/">MapTool</a></li>
                    <li><a href="/aj-util/common/ObjectHelper-cn/">ObjectHelper</a></li>
                    <li><a href="/aj-util/common/RandomTools-cn/">RandomTools</a></li>
                    <li><a href="/aj-util/common/RegExpHelper-cn/">RegExpHelper</a></li>
                    <li><a href="/aj-util/common/StrUtil-cn/">StrUtil</a></li>
                    <li><a href="/aj-util/common/UrlCodec-cn/">UrlCodec</a></li>
                    <li><a href="/aj-util/common/XmlHelper-cn/">XmlHelper</a></li>
                </ul>
                <h3>Date 日期处理</h3>
                <ul>
                    <li><a href="/aj-util/date/intro-cn/">简介</a></li>
                    <li><a href="/aj-util/date/convert-cn/">万能日期类型转换</a></li>
                    <li><a href="/aj-util/date/formatter-cn/">日期格式化</a></li>
                </ul>
                <h3>Reflection 反射</h3>
                <ul>
                    <li><a href="/aj-util/reflect/Methods-cn/">Methods</a></li>
                    <li><a href="/aj-util/reflect/Types-cn/">Types</a></li>
                    <li><a href="/aj-util/reflect/Clazz-cn/">Clazz</a></li>
                    <li><a href="/aj-util/reflect/NewInstance-cn/">NewInstance</a></li>
                    <li><a href="/aj-util/reflect/Fields-cn/">Fields</a></li>
                </ul>

                <h3>Input/Output 输入/输出</h3>
                <ul>
                    <li><a href="/aj-util/io/FileHelper-cn/">FileHelper</a></li>
                    <li><a href="/aj-util/io/ResourceHelper-cn/">ResourceHelper</a></li>
                    <li><a href="/aj-util/io/DataIO-cn/">DataReader/DataWriter</a></li>
                    <li><a href="/aj-util/io/ZipHelper-cn/">ZipHelper</a></li>
                    <li><a href="/aj-util/io/UnzipHelper-cn/">UnzipHelper</a></li>
                </ul>

                <h3>加密/解密</h3>
                <ul>
                    <li><a href="/aj-util/cryptography/intro-cn/">简介</a></li>
                    <li><a href="/aj-util/cryptography/flow-cn/">基本流程</a></li>
                    <li><a href="/aj-util/cryptography/Cryptography-cn/">对称加密</a></li>
                    <li><a href="/aj-util/cryptography/Rsa-cn/">RSA</a></li>
                </ul>
                <h3>其他</h3>
               <ul>
                <li><a href="/aj-util/misc/jackson3-cn/">升级到 Jackson3</a></li>
                <li><a href="/aj-util/misc/Logging-cn/">日志工具</a></li>
                <li><a href="/aj-util/misc/contact-cn/">联系</a></li>
               </ul>
                {% endif %}
                {% if project == "aj-http" %}
                <h3>HTTP 请求</h3>
                <ul>
                    <li><a href="/aj-http/http_request/Base-cn/">生命周期与响应</a></li>
                    <li><a href="/aj-http/http_request/Get-cn/">HTTP 方法辅助类</a></li>
                    <li><a href="/aj-http/http_request/Transfer-cn/">上传与下载</a></li>
                    <li><a href="/aj-http/http_request/ProxySecurity-cn/">代理、流与 TLS</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-qrcode" %}
                <h3>二维码</h3>
                <ul>
                    <li><a href="/aj-qrcode/getting-started-cn/">快速开始</a></li>
                    <li><a href="/aj-qrcode/rendering-cn/">PNG 与 SVG 渲染</a></li>
                    <li><a href="/aj-qrcode/segments-cn/">文本、字节与分段</a></li>
                    <li><a href="/aj-qrcode/advanced-cn/">高级编码与限制</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-s3client" %}
                <h3>S3 客户端</h3>
                <ul>
                    <li><a href="/aj-s3client/signature-v4-cn/">Signature Version 4</a></li>
                    <li><a href="/aj-s3client/signature-v2-cn/">Signature Version 2</a></li>
                    <li><a href="/aj-s3client/factories-cn/">厂商 Factory</a></li>
                    <li><a href="/aj-s3client/api-cn/">API 与限制</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-ftp" %}
                <h3>文件传输</h3>
                <ul>
                    <li><a href="/aj-ftp/upload-cn/">上传文件</a></li>
                    <li><a href="/aj-ftp/download-cn/">下载文件</a></li>
                </ul>
                {% endif %}
                {% if project == "aj-json" %}
                <h3>学习 JSON 解析</h3>
                <ul><li><a href="/aj-json/parse-cn/">动手解析 JSON</a></li><li><a href="/aj-json/how-it-works-cn/">解析器如何工作</a></li></ul>
                {% endif %}
            </menu>
            <article class="aj-text chinese">
                {{ content | safe }}
            </article>
        </div>

       <footer>
            {{ project }}，开源框架 <a href="https://framework.ajaxjs.com" target="_blank">AJ-Framework</a> 的一部分。联系方式：
            frank@ajaxjs.com，<a href="https://blog.csdn.net/zhangxin09" target="_blank">作者博客</a>
            <br />
            <br />
            Copyright © 2025 Frank Cheung. All rights reserved.
        </footer>
    </body>
</html>
